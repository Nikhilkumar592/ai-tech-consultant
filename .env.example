# === API Keys ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === Task 1: Knowledge Brain ===
KB_HOST=0.0.0.0
KB_PORT=8000
KB_DATABASE_URL=sqlite:///./knowledge_brain.db
KB_CHROMA_PATH=./chroma_data
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Crawler settings
KB_CRAWL_CONCURRENCY=3
KB_CRAWL_DELAY_SECONDS=2.0
KB_CRAWL_TIMEOUT_SECONDS=30
KB_CRAWL_MAX_RETRIES=3
KB_CRAWL_BATCH_SIZE=10

# Claude model settings
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-20250514
CLAUDE_COMPLEX_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# === Task 2: Inbox Agent ===
INBOX_PORT=3000
KB_API_URL=http://localhost:8000

# === Task 3: Meeting to Scope ===
MTS_PORT=8001
MTS_KB_API_URL=http://localhost:8000

# === General ===
LOG_LEVEL=INFO
MOCK_MODE=false
